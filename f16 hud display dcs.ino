int convertFuelDigit(unsigned int rawValue) {
    // convertim 0–65535 in 1–9
    int val = (rawValue * 9) / 65535 + 1;
    if(val > 9) val = 9;    // siguranță
    if(val < 1) val = 1;
    return val;
}

