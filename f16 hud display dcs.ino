    tft.setTextColor(TFT_WHITE, 0x0);
    tft.setTextSize(2);
    tft.fillRect(78, 120, 30, 16, 0x0000); // curăță zona înainte
    combustibil = constrain(combustibil, 1, 99);
    tft.drawString(String(combustibil) + "%", 78, 120);

    // Flaps
    tft.fillRect(11, 84, 30, 16, 0x0000);
    tft.drawString(poz_flaps ? "ON " : "OFF", 11, 84);

    // Throttle
    tft.fillRect(78, 84, 30, 16, 0x0000);
    acc=constrain(acc,1,99);
    tft.drawString(String(acc) + "%", 78, 84);

    // AirBrake
    tft.fillRect(11, 120, 30, 16, 0x0000);
    tft.drawString(poz_frana ? "ON " : "OFF", 11, 120);
    
    if (poz_gear != lastGearState) {
        lastGearState = poz_gear;
        if (poz_gear)
            tft.pushImage(11, 3, 104, 36, image_gearup_pixels);
        else
            tft.pushImage(11, 3, 104, 41, image_geardown_pixels);
    }
}

void setup() {
    // Serial pentru DCS-BIOS (OBLIGATORIU exact 250000)
    Serial.begin(250000);

    // Inițializare DCS-BIOS
    DcsBios::setup();

    // Inițializare display
    tft.init();
    //tft.setRotation(1);   // dacă ai nevoie (opțional)
    tft.fillScreen(TFT_BLACK);

    // Reset stări interne
    lastPowerState = false;
    uiDirty = true;       // forțăm primul redraw
    lastUiUpdate = 0;

    // Afișare inițială
    poweroff();
}

void loop() {
    DcsBios::loop();

    unsigned long now = millis();

    // Detectăm schimbarea alimentării
    if (alimentare != lastPowerState) {
        lastPowerState = alimentare;

        if (alimentare)
            poweron();
        else
            poweroff();

        uiDirty = true;   // forțăm redraw
    }

    // UI update:
    // 1) dacă s-au schimbat datele
    // 2) SAU dacă au trecut >40ms
    if (uiDirty || (now - lastUiUpdate >= UI_REFRESH_MS)) {
        lastUiUpdate = now;
        uiDirty = false;

        if (alimentare)
            updateUI();
        // dacă nu e alimentare, poweroff() deja e afișat
    }
}

