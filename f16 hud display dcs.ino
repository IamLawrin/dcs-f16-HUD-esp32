void updateThrottle() {
    int tach = engine_tach;

    // Sub idle → 0%
    if (tach <= TACH_IDLE) {
        acc = 0;
        return;
    }

    // Peste max → 99%
    if (tach >= TACH_MAX) {
        acc = 99;
        return;
    }

    // Calcul procent
    acc = (tach - TACH_IDLE) * 99 / (TACH_MAX - TACH_IDLE);

    // Siguranță
    acc = constrain(acc, 0, 99);
}


void updateFuelTotal() {
    // Fuel_Total = X*10k + Y*1K + Z*100
    fuel_total = fuel_10k * 10000 + fuel_1k * 1000 + fuel_100 * 100;

    // Procent
    combustibil = (fuel_total * 100) / 12113;

    // Limitam intre 1 si 99%
    if(combustibil > 99) combustibil = 99;
    if(combustibil < 1)  combustibil = 1;

    // Optional: actualizeaza UI imediat
    //updateUI();
}

